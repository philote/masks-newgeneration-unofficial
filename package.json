{
  "name": "masks-newgeneration-unofficial",
  "version": "2.1.2",
  "author": "Charlie Incorvia",
  "description": "Masks system for Foundry VTT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philote/masks-newgeneration-unofficial.git"
  },
  "homepage": "https://github.com/philote/masks-newgeneration-unofficial",
  "bugs": "https://github.com/philote/masks-newgeneration-unofficial/issues",
  "browserslist": [
    "last 3 versions"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "sass src/scss/masks-sheets.scss:css/masks-sheets.css src/scss/dark-mode.scss:css/dark-mode.css src/scss/light-mode.scss:css/light-mode.css --style=expanded --no-source-map",
    "watch": "sass src/scss/masks-sheets.scss:css/masks-sheets.css src/scss/dark-mode.scss:css/dark-mode.css src/scss/light-mode.scss:css/light-mode.css --style=expanded --source-map --watch",
    "sync-manifest": "node ./tools/sync-manifest.mjs",
    "pushLDBtoJSON": "node ./tools/pushLDBtoJSON.mjs",
    "pullJSONtoLDB": "node ./tools/pullJSONtoLDB.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "sass": "^1.53.0",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "@vitest/coverage-v8": "^2.1.5",
    "happy-dom": "^15.11.6",
    "vitest": "^2.1.5"
  }
}
